# ── Server ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth ───────────────────────────────────────────────────────────────────
# REQUIRED. Set a long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (used in index.ts).
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# ── Database (Prisma / PostgreSQL) ────────────────────────────────────────
# Local dev via docker-compose:  docker-compose up -d postgres
DATABASE_URL=postgresql://jplingo:jplingo@localhost:5432/jplingo_dev?schema=public

# ── Redis (optional cache/session layer) ──────────────────────────────────
REDIS_URL=redis://localhost:6379
