    "grammarPoints": [
      {
        "title": "〜ものの",
        "explanation": "Use 〜ものの in formal or written Japanese to contrast two facts with a nuanced \"although.\"",
        "examples": [
          "難しいものの挑戦したいです。(Although it is difficult, I want to take on the challenge.)",
          "理解はしたものの、納得はしていません。(Although I understood it, I am not convinced.)"
        ]
      },
      {
        "title": "〜とはいえ",
        "explanation": "Use 〜とはいえ when acknowledging one fact while introducing an important limitation or counterpoint.",
        "examples": [
          "春とはいえ、朝はまだ寒いです。(Though it is spring, mornings are still cold.)",
          "有名とはいえ、誰でも知っているわけではありません。(Though it is famous, not everyone knows it.)"
        ]
      }
    ],
