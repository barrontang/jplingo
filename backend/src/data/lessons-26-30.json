    "jlptLevel": "N3",
    "grammarPoints": [
      {
        "title": "〜たら",
        "explanation": "Use 〜たら to express a condition or sequence after something happens or becomes true.",
        "examples": [
          "駅に着いたら電話してください。(Please call me when you arrive at the station.)",
          "暇だったらいっしょに散歩しませんか。(If you are free, would you like to take a walk together?)"
        ]
      },
      {
        "title": "〜ても",
        "explanation": "Use 〜ても to show that a result holds true even when a condition changes.",
        "examples": [
          "雨が降っても試合はあります。(Even if it rains, the game will take place.)",
          "忙しくても毎日少し日本語を勉強します。(Even if I am busy, I study a little Japanese every day.)"
        ]
