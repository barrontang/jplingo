    "isUnlocked": false,
    "jlptLevel": "N3",
    "grammarPoints": [
      {
        "title": "〜なら",
        "explanation": "Use 〜なら to react to a condition, topic, or assumption already under discussion.",
        "examples": [
          "雨なら家で勉強します。(If it rains, I will study at home.)",
          "駅に近いならそのホテルにします。(If it is near the station, I will choose that hotel.)"
        ]
      },
      {
        "title": "〜ば",
        "explanation": "Use 〜ば to express a conditional result, especially for general or logical consequences.",
        "examples": [
          "時間があれば参加します。(If I have time, I will join.)",
          "早く寝れば明日は元気です。(If you sleep early, you will feel well tomorrow.)"
        ]
      }
    ],
